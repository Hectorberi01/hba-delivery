<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- LA CARTE SEULE N'EN A PAS BESOIN : c'est « ma position » qui l'exige.
         COARSE suffit a centrer le plan sur le quartier, FINE sert a poser le
         point d'enlevement au bon endroit. Android demande les deux ensemble et
         laisse l'utilisateur choisir la precision qu'il accorde. -->
    <!-- DECLARE ICI, ET PAS SEULEMENT HERITE. La permission arrivait jusqu'a
         present par le manifeste fusionne d'une dependance ; l'application
         elle-meme ne la demandait dans aucune variante sauf « profile ». Elle
         fonctionnait donc par effet de bord, et aurait cesse de fonctionner le
         jour ou cette dependance changerait — sans que rien ne relie la panne
         a sa cause. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:label="hba_client"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- LA CLE N'EST PAS DANS CE FICHIER, ET C'EST VOULU. Elle vient de
             android/local.properties, qui n'est pas versionne, via un
             manifestPlaceholder. Une cle Maps mobile voyage de toute facon dans
             le binaire et se restreint par empreinte de signature plutot qu'en
             la cachant — mais la laisser dans le depot la rendrait publique
             AVANT meme d'etre restreinte, et la rotation demanderait un commit. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- ANDROID 11 CACHE LES AUTRES APPLICATIONS PAR DEFAUT. Sans ces
             declarations, url_launcher ne VOIT pas le composeur ni le
             navigateur : l'appel part, ne leve aucune erreur, et ne produit
             rien. C'est la contrepartie exigee par la plateforme pour chaque
             schema que l'application ouvre.

             POURQUOI « tel » ICI. La vue integree du paiement confie au
             systeme tout ce qui n'est pas http(s), et le mobile money bascule
             volontiers sur un code USSD. Sans cette entree, le paiement
             s'arreterait au moment precis ou l'operateur prend la main. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>

        <!-- POURQUOI « mailto » AUSSI. « Ecrire au support » ouvre le client
             de messagerie du telephone. Sans cette entree, l'appel part, ne
             leve aucune erreur, et ne produit rien : le client appuie trois
             fois et conclut que l'application est cassee. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>

        <!-- Le navigateur reste necessaire pour les liens qui sortent
             franchement de l'application : conditions, confidentialite. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
