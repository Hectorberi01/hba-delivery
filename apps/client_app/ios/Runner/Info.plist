<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Hba Client</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>hba_client</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- NSAllowsLocalNetworking, ET SURTOUT PAS NSAllowsArbitraryLoads.

		     iOS refuse tout HTTP en clair. En developpement l'application parle
		     au BFF qui tourne sur le Mac, en http, sur une adresse privee du
		     reseau local : sans exception, la requete est coupee avant meme de
		     partir, et Dio la rapporte en connectionError, que l'application
		     affiche « Pas de reseau ».

		     Cette cle ouvre le clair UNIQUEMENT vers les adresses du reseau
		     local (RFC 1918 et .local). NSAllowsArbitraryLoads, lui, ouvrirait
		     le clair vers l'Internet entier, y compris en production, et vaut a
		     l'App Store une justification a fournir. Ici il n'y a rien a
		     justifier : la production parle en https a un nom public, que cette
		     cle ne concerne pas. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Depuis iOS 14, joindre une adresse du reseau local declenche une
	     demande d'autorisation. Sans ce texte, la demande n'apparait pas et la
	     connexion echoue en silence. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HBA Delivery se connecte au serveur de developpement sur votre reseau local.</string>
	<!-- Substituee au build depuis Flutter/Secrets.xcconfig, hors du depot.
	     AppDelegate la lit ici plutot que de la porter en dur dans le code. -->
	<key>GMSApiKey</key>
	<string>$(MAPS_API_KEY)</string>
	<!-- PHOTO DE PROFIL. SANS CES DEUX CLES, iOS TUE L'APPLICATION a la
	     premiere ouverture de l'appareil photo ou de la photothèque — pas une
	     erreur que Dart pourrait attraper, un arrêt net que rien dans les
	     journaux n'explique. L'application livreur les portait déjà ; le client
	     ne les a jamais eues, alors qu'il ouvre les deux
	     (photo_profil.dart : ImageSource.camera et ImageSource.gallery).

	     LES DEUX SONT NECESSAIRES, PAS UNE SEULE : la feuille de choix propose
	     « Prendre une photo » et « Choisir dans mes photos », et c'est le geste
	     de l'utilisateur qui décide laquelle des deux autorisations iOS
	     réclame. N'en déclarer qu'une ferait planter l'autre moitié des
	     utilisateurs.

	     ELLES CONDITIONNENT AUSSI LA PUBLICATION : la revue de l'App Store
	     refuse un binaire qui accède à l'appareil photo sans expliquer
	     pourquoi. Le texte ci-dessous est ce que l'utilisateur lit dans la
	     demande d'autorisation ; il dit l'usage, pas la fonctionnalité. -->
	<key>NSCameraUsageDescription</key>
	<string>HBA Delivery utilise l'appareil photo pour prendre votre photo de profil.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>HBA Delivery accède à vos photos pour que vous puissiez en choisir une comme photo de profil.</string>
	<!-- PAS DE NSPhotoLibraryAddUsageDescription : l'application ne RANGE
	     jamais rien dans la photothèque, elle y lit seulement. Déclarer une
	     autorisation dont on ne se sert pas se paie en questions à la revue. -->
	<!-- « Quand l'application est utilisee » et pas « toujours » : HBA n'a
	     aucune raison de suivre un client en arriere-plan. Le livreur, lui,
	     releve d'une autre application et d'une autre demande. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>HBA Delivery utilise votre position pour centrer la carte et pré-remplir l'adresse d'enlèvement.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
