// Copier en Secrets.xcconfig a cote, qui n'est PAS versionne.
//
// Cle Maps du projet Google Cloud, restreinte a l'identifiant de bundle iOS de
// l'application. Une cle Maps mobile voyage dans le binaire : on ne la protege
// pas en la cachant, on la protege en la restreignant. La garder hors du depot
// evite seulement qu'elle soit publique AVANT de l'etre, et permet d'en changer
// sans commit.
MAPS_API_KEY=REMPLACER
