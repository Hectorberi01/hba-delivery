# Adresse de la passerelle. En developpement, « make services-up » la publie ici.
HBA_GATEWAY_URL=http://localhost:5100

# Nom d'appareil envoye a Identity : il apparait dans la liste des sessions de
# l'utilisateur, et permet de revoquer une console sans toucher aux autres.
HBA_DEVICE_ID=console-web

# Cle Google Maps JS pour la carte des livreurs de la console.
#
# ELLE EST PUBLIQUE PAR CONSTRUCTION : NEXT_PUBLIC_ signifie que Next
# l'inscrit dans le paquet servi au navigateur. La proteger ne se fait donc
# pas en la cachant, mais en la restreignant cote Google Cloud — restriction
# par referent HTTP sur le domaine de la console, et API « Maps JavaScript »
# seule. Sans restriction, n'importe qui peut la reprendre et faire grimper
# la facture.
#
# Absente, la console affiche un encart qui la nomme et le reste fonctionne.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
