# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION. Elles sont dans le depot,
# donc publiques pour quiconque y a acces. En production, chaque secret est
# regenere (openssl rand -base64 32) et fourni par le .env de l'hote, jamais
# recopie depuis ce fichier.
#
# Copier en .env a cote du docker-compose du service. Le .env n'est pas versionne.

HBA_REGISTRY=ghcr.io/hectorberi01
HBA_TAG=latest
NOTIFICATIONDB_CONNECTION=Host=postgres;Port=5432;Database=hba_notification;Username=hba;Password=hba
KAFKA_BOOTSTRAP=kafka:9094
OTLP_ENDPOINT=http://otel-collector:4317
JWT_AUTHORITY=http://identity:8080
JWT_ISSUER=https://identity.hba.delivery
# WhatsApp Cloud API (Meta). « cloud » active l'envoi reel, « none » ne fait rien.
# Le jeton et l'identifiant de numero sont des SECRETS : ils vont dans .env,
# jamais dans ce fichier, qui a vocation a etre partage.
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=REMPLACER
WHATSAPP_ACCESS_TOKEN=REMPLACER
WHATSAPP_GRAPH_API_VERSION=v24.0

# Operateur SMS. « ovh » active l'envoi reel, « log » ecrit dans les journaux
# (developpement seulement), « none » ne fait rien.
SMS_PROVIDER=none

# OVHcloud SMS. ServiceName est de la forme sms-xx123456-1.
# ApplicationSecret et ConsumerKey sont des SECRETS : ils vont dans .env.
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_SMS_SERVICE_NAME=REMPLACER
OVH_APPLICATION_KEY=REMPLACER
OVH_APPLICATION_SECRET=REMPLACER
OVH_CONSUMER_KEY=REMPLACER
# Nom d'expediteur declare chez OVHcloud. Vide = numero court avec reponse
# possible, acceptable pour un test, a eviter pour un code de connexion.
OVH_SENDER=
