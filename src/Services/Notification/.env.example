# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION. Elles sont dans le depot,
# donc publiques pour quiconque y a acces. En production, chaque secret est
# regenere (openssl rand -base64 32) et fourni par le .env de l'hote, jamais
# recopie depuis ce fichier.
#
# Copier en .env a cote du docker-compose du service. Le .env n'est pas versionne.

HBA_REGISTRY=ghcr.io/hectorberi01
HBA_TAG=latest
NOTIFICATIONDB_CONNECTION=Host=postgres;Port=5432;Database=hba_notification;Username=hba;Password=hba
KAFKA_BOOTSTRAP=kafka:9094
OTLP_ENDPOINT=http://otel-collector:4317
JWT_AUTHORITY=http://identity:8080
JWT_ISSUER=https://identity.hba.delivery
# WhatsApp Cloud API (Meta). « cloud » active l'envoi reel, « none » ne fait rien.
# Le jeton et l'identifiant de numero sont des SECRETS : ils vont dans .env,
# jamais dans ce fichier, qui a vocation a etre partage.
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=REMPLACER
WHATSAPP_ACCESS_TOKEN=REMPLACER
WHATSAPP_GRAPH_API_VERSION=v24.0

# Operateur SMS. « ovh » active l'envoi reel, « log » ecrit dans les journaux
# (developpement seulement), « none » ne fait rien.
SMS_PROVIDER=none

# OVHcloud SMS. ServiceName est de la forme sms-xx123456-1.
# ApplicationSecret et ConsumerKey sont des SECRETS : ils vont dans .env.
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_SMS_SERVICE_NAME=REMPLACER
OVH_APPLICATION_KEY=REMPLACER
OVH_APPLICATION_SECRET=REMPLACER
OVH_CONSUMER_KEY=REMPLACER
# Nom d'expediteur declare chez OVHcloud. Vide = numero court avec reponse
# possible, acceptable pour un test, a eviter pour un code de connexion.
OVH_SENDER=

# ----------------------------------------------------------------------------
# COURRIEL — LE RECU DE COURSE (point 29)
#
# « resend » active l'envoi reel, « smtp » bascule sur le relais generique.
EMAIL_PROVIDER=resend

# LE DOMAINE DE L'EXPEDITEUR DOIT ETRE VERIFIE CHEZ RESEND — DKIM et SPF poses
# dans le DNS de hbatechettrade.com, puis valides dans leur tableau de bord —
# AVANT QU'UN SEUL MESSAGE NE PARTE. Sans cela, chaque envoi recoit un 403.
#
# LE PIEGE : avant verification, Resend n'autorise que onboarding@resend.dev,
# et uniquement vers l'adresse du titulaire du compte. Un essai qui « marche »
# dans ces conditions ne prouve RIEN sur la production.
#
# La cle est un SECRET : elle va dans .env, jamais dans ce fichier.
RESEND_API_KEY=REMPLACER
RESEND_FROM=HBA Delivery <recus@hbatechettrade.com>
# Le modele du recu invite le client a repondre. Si l'expediteur est une boite
# que personne ne releve, mettez ici l'adresse du support.
RESEND_REPLY_TO=hector.adjakpa@hbatechettrade.com

# Issue de secours, utilisee seulement si EMAIL_PROVIDER vaut « smtp ». Marche
# avec n'importe quel relais, y compris celui de Resend : smtp.resend.com,
# utilisateur « resend », mot de passe = la cle d'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=HBA Delivery
SMTP_REPLY_TO=

# ----------------------------------------------------------------------------
# JETON DE SERVICE (ADR 0018)
#
# CE SECRET NE SE DEMANDE A PERSONNE, IL SE CHOISIT : ni portail, ni table, ni
# commande d'enregistrement. C'est un secret PARTAGE, pose des deux cotes.
#
#     openssl rand -base64 48
#
# IL DOIT VALOIR EXACTEMENT LA MEME CHOSE que ServiceClients__Clients__notification
# dans le .env d'Identity. Un ecart ne se voit qu'au premier appel, ici.
#
# A QUOI IL SERT, ET A QUOI IL NE SERT PAS. Notification demande a Directory
# l'adresse d'un compte pour lui envoyer son recu ; l'appel descend d'un
# consommateur Kafka, donc sans jeton d'utilisateur a reporter. Sans ce secret,
# les codes de connexion et les codes de remise partent toujours — seul le recu
# de course reste au quai, consigne « ignore ».
SERVICE_SECRET_NOTIFICATION=hba-dev-service-notification-notforprod
