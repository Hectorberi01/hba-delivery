{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationDb": "Host=postgres;Port=5432;Database=hba_notification;Username=hba;Password=hba"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SecurityProtocol": "Plaintext"
  },
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Sms": {
    "Provider": "none",
    "SenderId": "HBA"
  },
  "Email": {
    "_commentaire": "Fournisseur du canal courriel : « resend » (defaut) ou « smtp ». Meme forme que Sms:Provider.",
    "Provider": "resend"
  },
  "Resend": {
    "_commentaire": "LE DOMAINE DE L'EXPEDITEUR DOIT ETRE VERIFIE CHEZ RESEND (DKIM et SPF) avant qu'un seul message ne parte : sinon chaque envoi recoit un 403. ApiKey n'est JAMAIS ici, elle vient de l'hote.",
    "ApiKey": "",
    "From": "",
    "ReplyTo": "",
    "TimeoutSeconds": 20
  },
  "Smtp": {
    "_commentaire": "Issue de secours, si Email:Provider vaut « smtp ». Marche avec n'importe quel relais, Resend compris. Password n'est JAMAIS ici, il vient de l'hote.",
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "HBA Delivery",
    "ReplyTo": "",
    "TimeoutSeconds": 20
  },
  "Services": {
    "Directory": "http://directory:8081"
  },
  "ServiceToken": {
    "_commentaire": "ADR 0018. Notification demande a Directory l'adresse d'un compte, depuis un consommateur Kafka : aucun utilisateur n'a declenche l'appel, donc aucun jeton a reporter. ClientSecret vient de l'hote.",
    "IdentityAddress": "http://identity:8081",
    "ClientId": "notification",
    "ClientSecret": ""
  },
  "Database": {
    "AutoMigrate": false
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "WhatsApp": {
    "Provider": "none",
    "PhoneNumberId": "",
    "AccessToken": "",
    "GraphApiVersion": "v24.0"
  },
  "Ovh": {
    "Endpoint": "https://eu.api.ovh.com/1.0",
    "ServiceName": "",
    "ApplicationKey": "",
    "ApplicationSecret": "",
    "ConsumerKey": "",
    "Sender": "",
    "NoStopClause": true
  }
}
