# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION. Elles sont dans le depot,
# donc publiques pour quiconque y a acces. En production, chaque secret est
# regenere (openssl rand -base64 32) et fourni par le .env de l'hote, jamais
# recopie depuis ce fichier.
#
# Copier en .env a cote du docker-compose du service. Le .env n'est pas versionne.

HBA_REGISTRY=ghcr.io/hectorberi01
HBA_TAG=latest
IDENTITYDB_CONNECTION=Host=postgres;Port=5432;Database=hba_identity;Username=hba;Password=hba
KAFKA_BOOTSTRAP=kafka:9094
OTLP_ENDPOINT=http://otel-collector:4317
JWT_AUTHORITY=http://identity:8080
JWT_ISSUER=https://identity.hba.delivery
REDIS_PASSWORD=hba-redis-dev
DATA_PROTECTION_KEY=aGJhLWRldi1kYXRhLXByb3RlY3Rpb24ta2V5LTAwMDE=
OTP_PEPPER=aGJhLWRldi1vdHAtcGVwcGVyLW5vdGZvcnByb2QtMDE=

# ----------------------------------------------------------------------------
# JETONS DE SERVICE (ADR 0018)
#
# UN SERVICE QUI APPELLE DEPUIS UN CONSOMMATEUR KAFKA OU UN PLANIFICATEUR n'a
# aucun utilisateur dont reporter le jeton : il s'authentifie aupres d'Identity
# avec le secret ci-dessous, et Identity lui rend un jeton sans role.
#
# CE SECRET NE SE DEMANDE A PERSONNE, IL SE CHOISIT. Il n'y a ni portail, ni
# table, ni commande d'enregistrement : c'est un secret PARTAGE, pose des deux
# cotes de la configuration. Pour en fabriquer un :
#
#     openssl rand -base64 48
#
# IL DOIT VALOIR EXACTEMENT LA MEME CHOSE dans le .env d'Identity, qui declare
# le service, et dans celui du service appelant. Un ecart ne se voit qu'au
# premier appel, dans les journaux de l'appelant.
#
# LES VALEURS CI-DESSOUS SONT DE DEVELOPPEMENT : elles sont dans le depot, donc
# publiques. En production, chacune est regeneree et fournie par l'hote.
#
# Identity DECLARE les services autorises : une ligne par service appelant.
SERVICE_SECRET_DELIVERY=hba-dev-service-delivery-notforprod
SERVICE_SECRET_DISPATCH=hba-dev-service-dispatch-notforprod
SERVICE_SECRET_NOTIFICATION=hba-dev-service-notification-notforprod

# Directory fait effacer les medias d'un compte supprime, depuis un consommateur
# Kafka : sans ce secret, la photo survit a la suppression du compte.
SERVICE_SECRET_DIRECTORY=hba-dev-service-directory-notforprod
