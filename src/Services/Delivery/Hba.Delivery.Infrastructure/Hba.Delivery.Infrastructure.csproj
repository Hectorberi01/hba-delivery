<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hba.Delivery.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hba.Delivery.Application/Hba.Delivery.Application.csproj" />
    <ProjectReference Include="../Hba.Delivery.Domain/Hba.Delivery.Domain.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Grpc/Hba.BuildingBlocks.Grpc.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Messaging/Hba.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Persistence/Hba.BuildingBlocks.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddHttpClient : cette bibliotheque n'est pas un projet web, elle ne
         recoit donc pas Microsoft.Extensions.Http par le framework. Elle en a
         besoin depuis le depot des preuves, qui parle a Media en HTTP. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" />
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>

</Project>
