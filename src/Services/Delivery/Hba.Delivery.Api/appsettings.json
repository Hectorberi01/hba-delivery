{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DeliveryDb": "Host=postgres;Port=5432;Database=hba_delivery;Username=hba;Password=hba"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SecurityProtocol": "Plaintext"
  },
  "Outbox": {
    "BatchSize": 100,
    "PollingInterval": "00:00:01",
    "MaxAttempts": 10
  },
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "Services": {
    "Pricing": "http://pricing:8080",
    "Payment": "http://payment:8080",
    "Driver": "http://driver:8080"
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Database": {
    "AutoMigrate": false
  }
}
