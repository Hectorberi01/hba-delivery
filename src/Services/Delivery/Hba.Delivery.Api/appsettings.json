{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DeliveryDb": "Host=postgres;Port=5432;Database=hba_delivery;Username=hba;Password=hba"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SecurityProtocol": "Plaintext"
  },
  "UnpaidDelivery": {
    "_commentaire": "Quinze minutes : la duree de vie d'un devis Pricing. Au-dela, le prix fige n'engage plus personne.",
    "GraceMinutes": 15,
    "SweepMinutes": 1,
    "BatchSize": 100
  },
  "Outbox": {
    "BatchSize": 100,
    "PollingInterval": "00:00:01",
    "MaxAttempts": 10
  },
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "Services": {
    "Pricing": "http://pricing:8081",
    "Payment": "http://payment:8081",
    "Driver": "http://driver:8081",
    "Billing": "http://billing:8081",
    "MediaHttp": "http://media:8080"
  },
  "ServiceToken": {
    "_commentaire": "ADR 0018. ClientSecret n'est JAMAIS ici : il vient de l'hote. Vide, le service refuse de demarrer, ce qui est le comportement voulu.",
    "IdentityAddress": "http://identity:8081",
    "ClientId": "delivery",
    "ClientSecret": ""
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
