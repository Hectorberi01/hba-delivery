{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_commentaire": "Redis seulement : ce service ne possede aucune donnee et n'a pas de base. Vide, il calcule a chaque fois — plus lentement, mais il marche.",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "Routing": {
    "_commentaire": "« haversine » tant que la carte du Benin n'est pas preparee pour OSRM. Chaque mesure porte alors from_fallback, ce qui est la verite.",
    "Provider": "haversine",
    "OsrmBaseUrl": "http://osrm:5000",
    "TimeoutSeconds": 5,
    "CacheTtlSeconds": 3600
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
