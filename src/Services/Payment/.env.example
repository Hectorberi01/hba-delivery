# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION. Elles sont dans le depot,
# donc publiques pour quiconque y a acces. En production, chaque secret est
# regenere (openssl rand -base64 32) et fourni par le .env de l'hote, jamais
# recopie depuis ce fichier.
#
# Copier en .env a cote du docker-compose du service. Le .env n'est pas versionne.

HBA_REGISTRY=ghcr.io/hectorberi01
HBA_TAG=latest
PAYMENTDB_CONNECTION=Host=postgres;Port=5432;Database=hba_payment;Username=hba;Password=hba
KAFKA_BOOTSTRAP=kafka:9094
OTLP_ENDPOINT=http://otel-collector:4317
JWT_AUTHORITY=http://identity:8080
JWT_ISSUER=https://identity.hba.delivery

# FEDAPAY — A RENSEIGNER, LE SERVICE REFUSE DE DEMARRER SANS.
# Les deux valeurs se prennent dans le tableau de bord FedaPay, et ce ne sont
# PAS les memes : la cle secrete (sk_sandbox_… / sk_live_…) signe nos appels,
# le secret de webhook est genere avec l'endpoint et signe les notifications.
# Tant que FEDAPAY_ENVIRONMENT vaut « sandbox », aucun argent ne bouge.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Adresse ou le payeur revient apres la page de paiement. Purement cosmetique :
# rien n'est encaisse sur ce retour, seul le webhook fait foi.
FEDAPAY_CALLBACK_URL=
FEDAPAY_CUSTOMER_COUNTRY=bj

# Domaine ngrok fixe, si vous en avez un (gratuit, un par compte). « make tunnel »
# le lit ici. Sans lui, l'adresse change a chaque demarrage et le webhook doit
# etre redeclare chez FedaPay a chaque fois.
NGROK_DOMAIN=
