{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentDb": "Host=postgres;Port=5432;Database=hba_payment;Username=hba;Password=hba"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SecurityProtocol": "Plaintext"
  },
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "FedaPay": {
    "_commentaire": "Les cles ne sont JAMAIS dans ce fichier : elles arrivent par le .env du service. Hors developpement, une cle absente empeche le demarrage, parce qu'un service de paiement sans cle accepterait des commandes qu'il ne peut pas encaisser.",
    "Environment": "sandbox",
    "SecretKey": "",
    "WebhookSecret": "",
    "CallbackUrl": "",
    "CustomerCountry": "bj",
    "WebhookToleranceSeconds": 300
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
