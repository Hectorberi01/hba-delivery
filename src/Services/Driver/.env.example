# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION. Elles sont dans le depot,
# donc publiques pour quiconque y a acces. En production, chaque secret est
# regenere (openssl rand -base64 32) et fourni par le .env de l'hote, jamais
# recopie depuis ce fichier.
#
# Copier en .env a cote du docker-compose du service. Le .env n'est pas versionne.

HBA_REGISTRY=ghcr.io/hectorberi01
HBA_TAG=latest
DRIVERDB_CONNECTION=Host=postgres;Port=5432;Database=hba_driver;Username=hba;Password=hba
KAFKA_BOOTSTRAP=kafka:9094
OTLP_ENDPOINT=http://otel-collector:4317
JWT_AUTHORITY=http://identity:8080
JWT_ISSUER=https://identity.hba.delivery

# Positions des livreurs (Redis GEO). Sans mot de passe, le service refuse de
# demarrer : aucune position, donc aucune offre possible.
REDIS_PASSWORD=hba-redis-dev
# Delai au-dela duquel une position n'est plus consideree comme fiable.
DRIVER_POSITION_FRESHNESS_SECONDS=120

# STOCKAGE OBJET — pieces du dossier livreur (ADR 0021).
#
# LES DEUX CLES SE CREENT AVEC « make garage-init » ET NE SE REAFFICHENT PAS :
# Garage ne montre le secret qu'a la creation. Perdu, il faut supprimer la cle
# et en creer une autre.
OBJECTSTORE_ENDPOINT=garage:3900
OBJECTSTORE_REGION=hba
OBJECTSTORE_BUCKET=hba-driver-documents
# En clair a l'interieur du reseau Docker. Derriere un proxy TLS en
# production, mettre true et pointer l'endpoint sur le nom public.
OBJECTSTORE_USE_SSL=false
OBJECTSTORE_ACCESS_KEY=
OBJECTSTORE_SECRET_KEY=
# Duree de vie des URL signees rendues au livreur et a ops. Courte : une URL
# de piece d'identite qui traine dans un historique de navigateur est une
# fuite en differe.
OBJECTSTORE_URL_TTL_SECONDS=300

# L'ADRESSE DU STOCKAGE VUE DEPUIS LE CLIENT, et non depuis le service.
#
# Le service ecrit par OBJECTSTORE_ENDPOINT (« garage:3900 »), qui n'existe
# que dans le reseau Docker. Une URL signee, elle, est suivie par le
# navigateur de la console et par le telephone du livreur : laisse vide, ils
# rendent ERR_NAME_NOT_RESOLVED sur chaque vignette. Et l'hote ne se reecrit
# pas apres coup — la signature SigV4 le couvre.
#
# En developpement : l'IP de la machine sur le reseau local, PAS localhost,
# pour que la meme URL marche sur l'ordinateur et sur le telephone.
#   OBJECTSTORE_PUBLIC_ENDPOINT=192.168.1.24:3900
# En production : l'hote de la route du stockage, avec USE_SSL a true.
OBJECTSTORE_PUBLIC_ENDPOINT=
OBJECTSTORE_PUBLIC_USE_SSL=false
