# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION. Elles sont dans le depot,
# donc publiques pour quiconque y a acces. En production, chaque secret est
# regenere (openssl rand -base64 32) et fourni par le .env de l'hote, jamais
# recopie depuis ce fichier.
#
# Copier en .env a cote du docker-compose du service. Le .env n'est pas versionne.

HBA_REGISTRY=ghcr.io/hectorberi01
HBA_TAG=latest
PRICINGDB_CONNECTION=Host=postgres;Port=5432;Database=hba_pricing;Username=hba;Password=hba
KAFKA_BOOTSTRAP=kafka:9094
OTLP_ENDPOINT=http://otel-collector:4317
JWT_AUTHORITY=http://identity:8080
JWT_ISSUER=https://identity.hba.delivery

# TARIFICATION — VALEURS DE DEVELOPPEMENT, A NE PAS METTRE EN PRODUCTION.
#
# La zone de repli fait entrer TOUTE coordonnee dans « cotonou-centre », y
# compris un point situe en France : c'est ce qui permet de tester depuis
# l'etranger tant qu'aucun polygone n'est dessine. Vide en production.
PRICING_FALLBACK_ZONE=cotonou-centre

# Grille semee au premier demarrage si la table est vide. 200 XOF le kilometre,
# course minimale 500 XOF, part du livreur 75 %. Ni tarif de base ni prix a la
# minute : le prix suit la seule distance.
PRICING_SEED_TARIFF=true
PRICING_TARIFF_VERSION=dev-2026-09
PRICING_TARIFF_VEHICLE=1
PRICING_BASE_FARE=0
PRICING_PER_KM=200
PRICING_PER_MINUTE=0
PRICING_MINIMUM_FARE=500
PRICING_SURGE_BP=10000
PRICING_DRIVER_SHARE_BP=7500
