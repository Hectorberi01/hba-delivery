<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Hba.Pricing.Api</RootNamespace>
    <UserSecretsId>hba-pricing-api</UserSecretsId>
    <DockerfileContext>../../../..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hba.Pricing.Application/Hba.Pricing.Application.csproj" />
    <ProjectReference Include="../Hba.Pricing.Infrastructure/Hba.Pricing.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Grpc/Hba.BuildingBlocks.Grpc.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Observability/Hba.BuildingBlocks.Observability.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Security/Hba.BuildingBlocks.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" />
    <!-- Requis par « dotnet ef » : les outils EF Core chargent le projet de
         demarrage pour construire le DbContext, et refusent de s'executer sans
         ce paquet. PrivateAssets l'empeche de fuiter vers les consommateurs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
