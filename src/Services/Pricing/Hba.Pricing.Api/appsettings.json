{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PricingDb": "Host=postgres;Port=5432;Database=hba_pricing;Username=hba;Password=hba"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SecurityProtocol": "Plaintext"
  },
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "Zones": {
    "_commentaire": "Vide signifie AUCUNE ZONE, donc aucun prix. C'est le comportement correct hors developpement : livrer hors zone n'a pas de sens, et un repli global ferait entrer le monde entier dans une grille de Cotonou.",
    "FallbackZoneCode": ""
  },
  "Tariff": {
    "Initial": {
      "_commentaire": "Desactivee. Les grilles de production sont administrees par ops et admin, pas semees au demarrage.",
      "Enabled": false
    }
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
