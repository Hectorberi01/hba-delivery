# Copie ce fichier en « .env » et renseigne les valeurs.
#
# LA CHAINE DE CONNEXION PORTE UN MOT DE PASSE : ce fichier-ci est versionne,
# le .env ne l'est pas.
BILLINGDB_CONNECTION=Host=postgres;Port=5432;Database=hba_billing;Username=hba;Password=CHANGEZ_MOI
JWT_ISSUER=https://identity.hba.delivery
JWT_AUTHORITY=http://identity:8080
KAFKA_BOOTSTRAP=kafka:9094
OTLP_ENDPOINT=http://otel-collector:4317

# A « true » uniquement sur un poste de developpement : en production les
# migrations s'appliquent a la main, avec « make migrate ».
BILLING_AUTOMIGRATE=false
