<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hba.Billing.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hba.Billing.Application/Hba.Billing.Application.csproj" />
    <ProjectReference Include="../Hba.Billing.Domain/Hba.Billing.Domain.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Messaging/Hba.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Hba.BuildingBlocks.Persistence/Hba.BuildingBlocks.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LE DEPOT EST « internal », ET LE TEST DU VERROU DOIT L'APPELER.
         « FOR UPDATE » vit dans BillingAccountRepository et nulle part
         ailleurs : le tester en recopiant le SQL dans le test prouverait que
         la copie fonctionne, pas le code livre. Le rendre public pour un test
         serait pire — le depot n'a rien a faire hors de cette couche. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Hba.Billing.Integration.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
