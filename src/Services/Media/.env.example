# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION.
#
# Copier en .env a cote du docker-compose du service.

HBA_REGISTRY=ghcr.io/hectorberi01
HBA_TAG=latest
MEDIADB_CONNECTION=Host=postgres;Port=5432;Database=hba_media;Username=hba;Password=hba
OTLP_ENDPOINT=http://otel-collector:4317
JWT_AUTHORITY=http://identity:8080
JWT_ISSUER=https://identity.hba.delivery

# STOCKAGE OBJET — LES DEUX CLES SONT ECRITES PAR « make garage-init ».
#
# Elles n'existent qu'apres son passage, et Garage n'affiche le secret qu'une
# seule fois : ne les recopiez pas a la main. Le service refuse de demarrer si
# elles manquent, plutot que d'accepter des fichiers et de les perdre.
OBJECTSTORE_ENDPOINT=garage:3900
OBJECTSTORE_BUCKET=hba-media
OBJECTSTORE_ACCESS_KEY=
OBJECTSTORE_SECRET_KEY=

# ADRESSE VUE DEPUIS LE TELEPHONE, pas depuis le reseau Docker.
#
# Une URL signee est suivie par l'appareil du client : il ne resout ni
# « garage », ni « localhost ». Et la signature SigV4 couvre l'en-tete Host,
# donc l'adresse doit etre connue AU MOMENT de signer — on ne peut pas la
# reecrire apres coup. En developpement : l'IP du Mac sur le reseau local.
OBJECTSTORE_PUBLIC_ENDPOINT=
OBJECTSTORE_PUBLIC_SSL=false
