{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_commentaire": "Valeurs de developpement uniquement. En conteneur, le docker-compose du service impose ConnectionStrings__RatingDb et refuse de demarrer sans.",
    "RatingDb": "Host=postgres;Port=5432;Database=hba_rating;Username=hba;Password=hba"
  },
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "Kafka": {
    "BootstrapServers": "kafka:9094"
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
