{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://identity:8080",
    "Issuer": "https://identity.hba.delivery",
    "Audience": "hba-delivery",
    "RequireHttpsMetadata": false
  },
  "Services": {
    "Delivery": "http://delivery:8080",
    "Pricing": "http://pricing:8080",
    "Dispatch": "http://dispatch:8080",
    "Driver": "http://driver:8080",
    "Identity": "http://identity:8080",
    "Payment": "http://payment:8080",
    "Directory": "http://directory:8080"
  },
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "ForwardedHeaders": {
    "TrustAllProxies": true
  }
}
