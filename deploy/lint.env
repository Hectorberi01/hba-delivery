# VALEURS FACTICES, RESERVEES A « make lint-compose ».
#
# Les composes de service declarent leurs variables sensibles en ${VAR:?...} :
# Compose refuse de demarrer si l'une manque. C'est voulu en deploiement, mais
# la validation syntaxique, elle, n'a pas a connaitre les secrets de production.
#
# NE JAMAIS UTILISER CE FICHIER POUR DEMARRER QUOI QUE CE SOIT.
POSTGRES_USER=lint
POSTGRES_PASSWORD=lint
IDENTITYDB_CONNECTION=lint
DIRECTORYDB_CONNECTION=lint
DELIVERYDB_CONNECTION=lint
PRICINGDB_CONNECTION=lint
DISPATCHDB_CONNECTION=lint
DRIVERDB_CONNECTION=lint
PAYMENTDB_CONNECTION=lint
NOTIFICATIONDB_CONNECTION=lint
BILLINGDB_CONNECTION=lint
MEDIADB_CONNECTION=lint

# CES QUATRE MANQUAIENT, ET « make lint-compose » ECHOUAIT DONC SUR MEDIA ET
# PAYMENT AVANT MEME DE LES VALIDER. Des valeurs factices : la forme :? ne
# demande qu'une valeur non vide.
OBJECTSTORE_ACCESS_KEY=lint
OBJECTSTORE_SECRET_KEY=lint
FEDAPAY_SECRET_KEY=lint
FEDAPAY_WEBHOOK_SECRET=lint
JWT_ISSUER=lint
REDIS_PASSWORD=lint
OTP_PEPPER=lint
DATA_PROTECTION_KEY=lint
SERVICE_SECRET_DELIVERY=lint
SERVICE_SECRET_DISPATCH=lint
SERVICE_SECRET_NOTIFICATION=lint
SERVICE_SECRET_DIRECTORY=lint

# Secrets internes de Garage. Ils ont quitte deploy/garage/garage.toml le
# 30/09/2026 : ils arrivent par variable, sous la forme « :? », donc « config »
# echoue sans eux. Valeurs factices, comme tout ce fichier.
GARAGE_RPC_SECRET=lint
GARAGE_ADMIN_TOKEN=lint
GARAGE_METRICS_TOKEN=lint
