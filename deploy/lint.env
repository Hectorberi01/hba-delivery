# VALEURS FACTICES, RESERVEES A « make lint-compose ».
#
# Les composes de service declarent leurs variables sensibles en ${VAR:?...} :
# Compose refuse de demarrer si l'une manque. C'est voulu en deploiement, mais
# la validation syntaxique, elle, n'a pas a connaitre les secrets de production.
#
# NE JAMAIS UTILISER CE FICHIER POUR DEMARRER QUOI QUE CE SOIT.
POSTGRES_USER=lint
POSTGRES_PASSWORD=lint
IDENTITYDB_CONNECTION=lint
DIRECTORYDB_CONNECTION=lint
DELIVERYDB_CONNECTION=lint
PRICINGDB_CONNECTION=lint
DISPATCHDB_CONNECTION=lint
DRIVERDB_CONNECTION=lint
PAYMENTDB_CONNECTION=lint
NOTIFICATIONDB_CONNECTION=lint
JWT_ISSUER=lint
REDIS_PASSWORD=lint
OTP_PEPPER=lint
DATA_PROTECTION_KEY=lint
SERVICE_SECRET_DELIVERY=lint
SERVICE_SECRET_DISPATCH=lint
