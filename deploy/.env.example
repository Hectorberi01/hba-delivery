# Copier en .env à côté de docker-compose.prod.yml. Ne jamais versionner .env.
POSTGRES_USER=hba
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_USER=hba
MINIO_PASSWORD=
JWT_ISSUER=https://identity.hba.delivery

# FedaPay — clés de production, à ne stocker que sur l'hôte.
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Identity — clé AES-256 en base64 (openssl rand -base64 32)
DATA_PROTECTION_KEY=
# Identity — poivre du hachage des codes SMS (openssl rand -base64 32)
OTP_PEPPER=
