# VALEURS DE DEVELOPPEMENT. ELLES FONCTIONNENT TELLES QUELLES CONTRE « make up ».
#
# AUCUNE DE CES VALEURS NE DOIT PARTIR EN PRODUCTION. Elles sont dans le depot,
# donc publiques pour quiconque y a acces. En production, chaque secret est
# regenere (openssl rand -base64 32) et fourni par le .env de l'hote, jamais
# recopie depuis ce fichier.
#
# Copier en .env a cote du docker-compose du service. Le .env n'est pas versionne.

POSTGRES_USER=hba
POSTGRES_PASSWORD=hba
REDIS_PASSWORD=hba-redis-dev
# Garage (ADR 0021). Ces deux valeurs ne sont PAS des identifiants S3 : ce
# sont les secrets internes du noeud, lus depuis deploy/garage/garage.toml.
# Les identifiants S3, eux, sont crees par « make garage-init » et se
# reportent dans le .env du service Driver.
GARAGE_RPC_SECRET=b9a1f4c0d2e7368a5b1c9d0e4f7a2b8c3d6e9f0a1b2c3d4e5f6a7b8c9d0e1f2a
GARAGE_ADMIN_TOKEN=hba-garage-admin-dev
JWT_ISSUER=https://identity.hba.delivery

# Fuseau metier : celui dans lequel se decoupent les journees des tableaux de
# bord. Le Benin est a UTC+1 toute l'annee. Une partie de l'UEMOA est a UTC+0
# (Mali, Senegal) : d'ou un reglage, et non une constante.
HBA_TIMEZONE=Africa/Porto-Novo

# FedaPay — clés de production, à ne stocker que sur l'hôte.
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Identity — clé AES-256 en base64 (openssl rand -base64 32)
DATA_PROTECTION_KEY=aGJhLWRldi1kYXRhLXByb3RlY3Rpb24ta2V5LTAwMDE=
# Identity — poivre du hachage des codes SMS (openssl rand -base64 32)
OTP_PEPPER=aGJhLWRldi1vdHAtcGVwcGVyLW5vdGZvcnByb2QtMDE=

# Secrets des services internes (ADR 0018). La MEME valeur doit figurer dans le
# .env d'Identity et dans celui du service concerne : Identity la verifie,
# le service la presente. En production : openssl rand -base64 32, un par service.
SERVICE_SECRET_DELIVERY=hba-dev-service-delivery
SERVICE_SECRET_DISPATCH=hba-dev-service-dispatch

# Premier administrateur, cree au demarrage d'Identity s'il n'en existe aucun.
# Vider ces deux lignes desactive l'amorcage.
BOOTSTRAP_ADMIN_EMAIL=admin@hba.local
BOOTSTRAP_ADMIN_PASSWORD=HbaDev!2026
# Reprise en main : repose le mot de passe du compte ci-dessus s'il existe
# deja. Refuse hors Development. A laisser a false.
BOOTSTRAP_ADMIN_RESET=false
